# Copy to .env.local (ignored by git) and fill in. Never commit real values.
#
# Local stack: run `supabase status` on the server for the API URL and anon key.
# To open the dev server on a phone, use the server's LAN or Tailscale address instead of 127.0.0.1
# (see SERVER.md). Cloud project values are in private/env/ on the server.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional ([4.4]): the web push public key (VAPID). Without it, Settings says notifications are not set up.
# The private key never goes here; it lives only in the notify Edge Function secrets and private/env/.
VITE_VAPID_PUBLIC_KEY=
